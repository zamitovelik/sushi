# Строка подключения к Postgres. Локально и на Vercel — одна и та же
# переменная; Neon выдаёт готовую строку вида
# postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Раньше здесь была SQLite (file:./dev.db). На Vercel такой файл не
# переживает даже один запрос: файловая система там временная, поэтому
# регистрация и заказы терялись бы между вызовами.
DATABASE_URL=

# Отправка заказов и заявок на звонок в Telegram. Без этих переменных
# уведомления просто не уходят — оформление заказа продолжает работать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
