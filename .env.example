# Локальная база разработки. Путь считается от корня проекта (там, где
# лежит prisma.config.ts), файл появится как ./dev.db.
#
# Для продакшена задавайте АБСОЛЮТНЫЙ путь: относительный резолвится от
# текущей рабочей директории процесса, а она при запуске через systemd
# или Docker может отличаться от корня проекта.
# Пример: DATABASE_URL="file:/var/lib/mrsushi/prod.db"
DATABASE_URL="file:./dev.db"

# Отправка заказов в Telegram. Без этих переменных заказы просто
# не уходят в бот — оформление заказа при этом продолжает работать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
